    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --utama: #2c3e50;
            --aksen: #3498db;
            --terang: #f8f9fa;
            --gelap: #333;
            --abu: #ecf0f1;
        }

        body {
            line-height: 1.6;
            color: var(--gelap);
            background-color: #fff;
        }

        nav {
            background: var(--utama);
            padding: 1rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        nav ul {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            justify-content: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--aksen);
        }

        section {
            padding: 80px 5% 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        h2 {
            color: var(--utama);
            margin-bottom: 2rem;
            padding-bottom: 0.5rem;
            border-bottom: 3px solid var(--aksen);
            display: inline-block;
        }

        .beranda {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(135deg, var(--utama), var(--aksen));
            color: white;
            padding-top: 60px;
        }

        .beranda h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .beranda p {
            font-size: 1.2rem;
            max-width: 600px;
        }

        .kartu {
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .statistik {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 1rem;
            margin: 2rem 0;
        }

        .stat {
            text-align: center;
            background: var(--abu);
            padding: 1rem;
            border-radius: 8px;
        }

        .stat h3 {
            font-size: 1.8rem;
            color: var(--aksen);
        }

        .grid-dua {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .pencapaian {
            margin-bottom: 2rem;
            padding-left: 1rem;
            border-left: 3px solid var(--aksen);
        }

        .tag {
            display: inline-block;
            background: var(--aksen);
            color: white;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            margin: 0.25rem;
            font-size: 0.9rem;
        }

        .tautan {
            display: inline-block;
            background: var(--aksen);
            color: white;
            padding: 0.7rem 1.5rem;
            border-radius: 5px;
            text-decoration: none;
            margin: 0.5rem;
            transition: background 0.3s;
        }

        .tautan:hover {
            background: var(--utama);
        }

        footer {
            background: var(--utama);
            color: white;
            text-align: center;
            padding: 2rem;
            margin-top: 2rem;
        }
    </style>
</head>
